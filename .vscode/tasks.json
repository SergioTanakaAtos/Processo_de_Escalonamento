{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Django Unit Tests",
            "type": "shell",
            "command": "python",
            "args": [
                "manage.py",
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$tsc"
        }
    ]
}
